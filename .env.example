# Local development only. Copy to .env before `docker compose up`.
# Do not put live Stripe keys or production passwords in this file.

POSTGRES_DB=rhdp
POSTGRES_USER=rhdp
POSTGRES_PASSWORD=rhdp_local_dev

DATABASE_URL=jdbc:postgresql://postgres:5432/rhdp
DATABASE_USERNAME=rhdp
DATABASE_PASSWORD=rhdp_local_dev

JWT_SECRET=local-dev-only-change-this-secret-key-32b
JWT_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_API_URL=http://localhost:8080

# Leave DEMO_USER_PASSWORD empty in any shared environment to skip seeding.
DEMO_USER_EMAIL=membre@rhdp-canada.local
DEMO_USER_PASSWORD=rhdp_local_dev
DEMO_USER_DISPLAY_NAME=Membre démo
